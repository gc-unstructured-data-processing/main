    "def fetch_corp_code_map(api_key: str, cache_dir: Path) -> pd.DataFrame:\n",
    "    \"\"\"corpCode.xml 1회 다운로드 → DataFrame → parquet 캐시.\n",
    "\n",
    "    Args:\n",
    "        api_key: OpenDART API key (mask_key 적용 후 출력 가능)\n",
